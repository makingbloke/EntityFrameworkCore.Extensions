<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EntityFrameworkCore.Extensions is a set of helper and extension methods for Entity Framework Core.</Description>
    <Version>6.0.0.16</Version>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DefaultDocumentation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="UUIDNext" />
  </ItemGroup>

  <!-- Make internal objects in this assembly visible to the test project -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- DefaultDocumentation writes the Markdown files as UTF-8 without a BOM, so add one after it runs (all text files in this repository are UTF-8 with a BOM). -->
  <UsingTask TaskName="AddUtf8Bom" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          foreach (ITaskItem file in Files)
          {
              string path = file.GetMetadata("FullPath");
              byte[] bytes = File.ReadAllBytes(path);

              if (bytes.Length < 3 || bytes[0] != 0xEF || bytes[1] != 0xBB || bytes[2] != 0xBF)
              {
                  byte[] withBom = new byte[bytes.Length + 3];
                  withBom[0] = 0xEF;
                  withBom[1] = 0xBB;
                  withBom[2] = 0xBF;
                  bytes.CopyTo(withBom, 3);
                  File.WriteAllBytes(path, withBom);
              }
          }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- The folder matches OutputDirectoryPath in DefaultDocumentation.json. -->
  <Target Name="AddUtf8BomToDocumentation" AfterTargets="DefaultDocumentation" Condition="'$(DisableDefaultDocumentation)' != 'true'">
    <ItemGroup>
      <_DocumentationMarkdownFiles Include="$(ProjectDir)Documentation\*.md" />
    </ItemGroup>
    <AddUtf8Bom Files="@(_DocumentationMarkdownFiles)" />
  </Target>

</Project>
